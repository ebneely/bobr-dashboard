# Production build defaults — PUBLIC values only, never a secret: every
# NEXT_PUBLIC_* ends up inlined in the browser bundle anyway. Vercel project
# environment variables override anything here; .env.local overrides it locally.
#
# NEXT_PUBLIC_API_URL is this app's OWN origin, not the API: the browser calls
# /v1/* same-origin and next.config.ts proxies it to API_UPSTREAM_URL. The
# session cookie is host-only, and vercel.app is on the Public Suffix List, so a
# cookie set by the API host (or by the storefront) can never reach this origin
# — calling the API directly signs you in and bounces you back to login
# (ebneely/bobr-dashboard#32). API_UPSTREAM_URL is server-only.
NEXT_PUBLIC_API_URL=https://bobr-dashboard.vercel.app
API_UPSTREAM_URL=https://api.bobr.207-180-195-37.sslip.io
NEXT_PUBLIC_STOREFRONT_URL=https://bobr-frontend.vercel.app
NEXT_PUBLIC_SITE_URL=https://bobr-dashboard.vercel.app
NEXT_PUBLIC_IMAGE_HOST=https://img.bobr.207-180-195-37.sslip.io
HTTPS_ENABLED=true
