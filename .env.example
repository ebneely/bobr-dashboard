# BOBR dashboard — copy to .env.local

# Where bobr_backend lives. The /v1 prefix is added by lib/api/client.ts.
NEXT_PUBLIC_API_URL=http://localhost:8003

NEXT_PUBLIC_SITE_URL=http://localhost:3101

# The storefront owns sign-in and registration; the dashboard redirects there.
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3100

# Development only, and ignored in a production build: fabricate a session with
# this role so the shell can be worked on before a database exists.
# One of CUSTOMER | ADMIN | DOCTOR.
# BOBR_DEV_STUB_ROLE=ADMIN

# Where meal photographs are served FROM, when that is not the API itself.
#
# With imgproxy configured, the API hands out URLs on the IMGPROXY_HOST origin;
# with a bucket but no imgproxy, on the S3 public endpoint. Either way the
# browser is told to load an image from an origin this app's CSP has never heard
# of, and blocks it: the card draws an empty frame and the only evidence is a
# console violation. Set this to that origin in production.
#
# Leave it empty when the API serves the bytes itself (no bucket, or local
# development) -- NEXT_PUBLIC_API_URL already covers that case.
NEXT_PUBLIC_IMAGE_HOST=

# --- Deployment --------------------------------------------------------------
# NEXT_PUBLIC_API_URL=http://backend.domain.com
# NEXT_PUBLIC_STOREFRONT_URL=http://domain.com
# NEXT_PUBLIC_SITE_URL=http://dashboard.domain.com
#
# See the storefront's .env.example for why HTTPS_ENABLED is a plain var and
# NEXT_PUBLIC_* are not.
HTTPS_ENABLED=false
